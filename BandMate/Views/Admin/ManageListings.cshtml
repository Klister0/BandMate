@model IEnumerable<BandMate.Models.Listing>

@{
    ViewData["Title"] = "İlan Yönetimi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Sistemdeki Tüm İlanlar</h2>
            <p class="text-muted mb-0">Kurallara uymayan ilanları buradan tamamen silebilirsiniz.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Paneline Dön</a>
    </div>
    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-warning">Sistemde henüz hiç ilan bulunmuyor.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle border mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Başlık</th>
                        <th>Kategori</th>
                        <th>Yayınlayan</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th class="text-center">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Listing" asp-action="Details" asp-route-id="@item.Id" target="_blank" class="text-decoration-none fw-bold text-dark">
                                    @item.Title
                                </a>
                            </td>
                            <td><span class="badge bg-info text-dark">@item.Category?.Name</span></td>
                            <td>
                                <span class="fw-bold">@item.User?.FullName</span><br />
                                <small class="text-muted">@item.User?.Email</small>
                            </td>
                            <td>@item.CreatedAt.ToShortDateString()</td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-center">
                                <form asp-action="DeleteListing" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu ilanı tamamen silmek istediğinize emin misiniz?');">
                                    <button type="submit" class="btn btn-danger btn-sm">SİL</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>