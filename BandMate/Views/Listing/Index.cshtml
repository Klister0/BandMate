@model IEnumerable<BandMate.Models.Listing>

@{
    ViewData["Title"] = "Aktif İlanlar";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white">Aktif İlanlar</h2>
        <a asp-action="Create" class="btn btn-success btn-sm rounded-pill"><i class="bi bi-plus"></i> Yeni İlan Ver</a>
    </div>

    <form asp-controller="Listing" asp-action="Index" method="get" class="row g-2 mb-4 p-3 bg-dark rounded-4 shadow border border-secondary">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-0 text-muted rounded-start-pill"><i class="bi bi-search"></i></span>
                <input type="text" name="searchInstrument" value="@ViewBag.CurrentInstrument" class="form-control rounded-end-pill border-0" placeholder="Enstrüman ara (örn: Gitar, Bateri)..." />
            </div>
        </div>
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-0 text-muted rounded-start-pill"><i class="bi bi-geo-alt"></i></span>
                <input type="text" name="searchCity" value="@ViewBag.CurrentCity" class="form-control rounded-end-pill border-0" placeholder="Şehir ara (örn: İstanbul, İzmir)..." />
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100 fw-bold rounded-pill">Filtrele</button>
        </div>
    </form>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow border border-secondary rounded-4 bg-dark text-white p-2">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-secondary text-dark rounded-pill">
                                <i class="bi bi-tags me-1"></i> @item.Category?.Name
                            </span>
                            <div class="text-muted small">
                                <i class="bi bi-geo-alt"></i> @item.City
                            </div>
                        </div>

                        <h5 class="card-title fw-bold text-white mb-2">
                            <i class="bi bi-music-note me-1 text-primary"></i> @item.Title
                        </h5>

                        <p class="card-text text-white-50 small mb-2">
                            <b>Enstrüman:</b> @item.Instrument
                        </p>

                        <p class="card-text text-white-50 small" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @item.Description
                        </p>
                    </div>

                    <div class="card-footer bg-transparent border-0 p-3 pt-0 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-warning fs-5">
                            @(item.Price.HasValue? item.Price.Value.ToString("C") : "Görüşülür")
                        </span>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold shadow-sm">
                            Detay Gör <i class="bi bi-arrow-right-circle ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>