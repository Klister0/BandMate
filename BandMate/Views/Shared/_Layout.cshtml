<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BandMate</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* Tarayıcının en dış katmanından itibaren her şeyi siyah yapıyoruz */
        html, body {
            background-color: #121212 !important;
            background: #121212 !important;
            color: #f8f9fa !important;
        }

        /* İçerikteki kapsayıcıların arka plan dayatmalarını sıfırlıyoruz */
        main, .container, .container-fluid {
            background-color: transparent !important;
        }

        /* Üst menüyü koyu gri yapıyoruz */
        .navbar {
            background-color: #1a1a1a !important;
        }
    </style>
</head>
<body style="background-color: #121212;">
    <header>
        <nav class="navbar navbar-expand-md navbar-dark shadow-sm border-bottom border-secondary mb-3 p-3">
            <div class="container-fluid">
                <a class="navbar-brand text-primary fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-music-note-beamed me-1"></i> BANDMATE
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Listing" asp-action="Index">İlanlar</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link text-primary fw-bold" asp-controller="Profile" asp-action="Index">
                                    <i class="bi bi-person-badge me-1"></i> Panelim
                                </a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link text-white-50">Merhaba, <b>@User.Identity.Name!</b></span>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item ms-2">
                                    <a class="nav-link text-danger fw-bold" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-shield-lock me-1"></i> Admin Paneli
                                    </a>
                                </li>
                            }
                            <li class="nav-item ms-2">
                                <a class="btn btn-outline-light btn-sm rounded-pill" asp-controller="Account" asp-action="Logout">Çıkış</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="btn btn-primary btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>